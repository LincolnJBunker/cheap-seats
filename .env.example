# Copy to .env (gitignored) for local runs. In GitHub Actions these come from repository secrets.
# Never put real values in this file.

# Role used by scheduled jobs and the CLI (member of the ft_worker group role).
# Neon example: postgresql+psycopg://ft_worker_login:<password>@<host>/neondb?sslmode=verify-full&sslrootcert=system
FT_DATABASE_URL=postgresql+psycopg://localhost/flighttracker

# Owner role used only for running migrations. Defaults to FT_DATABASE_URL when unset.
FT_MIGRATION_DATABASE_URL=

# Data sources (https://www.travelpayouts.com/ and https://serpapi.com/)
FT_TRAVELPAYOUTS_TOKEN=
FT_SERPAPI_KEY=

# Email (https://resend.com/). Without a verified domain Resend only delivers to your own account address.
FT_RESEND_API_KEY=
FT_ALERT_EMAIL_FROM=Flight Tracker <onboarding@resend.dev>

# Budgets (stay under the free tiers)
FT_SERPAPI_MONTHLY_LIMIT=240
FT_SERPAPI_MAX_PER_RUN=1
